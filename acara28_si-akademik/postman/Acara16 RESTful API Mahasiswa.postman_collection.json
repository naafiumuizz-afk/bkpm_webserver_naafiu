{
  "info": {
    "_postman_id": "ca16b99d-3cd0-4728-9a67-1fa133ed16a1",
    "name": "Acara 16 - RESTful API Mahasiswa",
    "description": "Pengujian endpoint CRUD mahasiswa. Ubah base_url sesuai nama folder proyek.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost/bkpm_webserver/acara16_si-akademik/api/mahasiswa"
    },
    {
      "key": "mahasiswa_id",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "GET - Semua Mahasiswa",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Response berisi daftar mahasiswa', function () {",
              "  const body = pm.response.json();",
              "  pm.expect(body.success).to.eql(true);",
              "  pm.expect(body.data).to.be.an('array');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "GET - Mahasiswa berdasarkan ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/{{mahasiswa_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Response berisi satu mahasiswa', function () {",
              "  const body = pm.response.json();",
              "  pm.expect(body.success).to.eql(true);",
              "  pm.expect(body.data).to.have.property('id');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "POST - Tambah Mahasiswa",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nim\": \"23005\",\n  \"nama\": \"Rina\",\n  \"email\": \"rina@gmail.com\",\n  \"prodi_id\": 1,\n  \"angkatan\": 2026\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{base_url}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201', function () { pm.response.to.have.status(201); });",
              "pm.test('Mahasiswa berhasil dibuat', function () {",
              "  const body = pm.response.json();",
              "  pm.expect(body.success).to.eql(true);",
              "  pm.expect(body.data).to.have.property('id');",
              "  pm.collectionVariables.set('mahasiswa_id', body.data.id);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "PUT - Ubah Mahasiswa",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nim\": \"23005\",\n  \"nama\": \"Rina Putri\",\n  \"email\": \"rina.putri@gmail.com\",\n  \"prodi_id\": 1,\n  \"angkatan\": 2026\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{base_url}}/{{mahasiswa_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Data mahasiswa berhasil diperbarui', function () {",
              "  const body = pm.response.json();",
              "  pm.expect(body.success).to.eql(true);",
              "  pm.expect(body.data.nama).to.eql('Rina Putri');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "DELETE - Hapus Mahasiswa",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{base_url}}/{{mahasiswa_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Mahasiswa berhasil dihapus', function () {",
              "  const body = pm.response.json();",
              "  pm.expect(body.success).to.eql(true);",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
