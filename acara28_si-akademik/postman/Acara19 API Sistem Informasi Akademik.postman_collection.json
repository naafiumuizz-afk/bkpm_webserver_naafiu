{
  "info": {
    "_postman_id": "ce51d529-91c3-4f90-870e-49bbd132561c",
    "name": "API Sistem Informasi Akademik (Acara 20 JWT)",
    "description": "Pengujian API mahasiswa dan autentikasi JWT Acara 20.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost/bkpm_webserver/acara20_si-akademik"
    },
    {
      "key": "mahasiswa_id",
      "value": "1"
    },
    {
      "key": "username",
      "value": ""
    },
    {
      "key": "password",
      "value": "BelajarAcara20!"
    },
    {
      "key": "jwt_token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Mahasiswa",
      "item": [
        {
          "name": "GET - Semua mahasiswa",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/mahasiswa"
          }
        },
        {
          "name": "GET - Mahasiswa berdasarkan ID",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/mahasiswa/{{mahasiswa_id}}"
          }
        },
        {
          "name": "POST - Tanpa token (harus 401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nim\": \"2599999\",\n  \"nama\": \"Uji Tanpa Token\",\n  \"email\": \"tanpa-token@example.com\",\n  \"prodi_id\": 1,\n  \"angkatan\": 2025\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/mahasiswa"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 401', function () { pm.response.to.have.status(401); });"
                ]
              }
            }
          ]
        },
        {
          "name": "POST - Token diubah (harus 401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer token-sengaja-diubah"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nim\": \"2599998\",\n  \"nama\": \"Uji Token Tidak Valid\",\n  \"email\": \"token-rusak@example.com\",\n  \"prodi_id\": 1,\n  \"angkatan\": 2025\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/mahasiswa"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 401', function () { pm.response.to.have.status(401); });"
                ]
              }
            }
          ]
        },
        {
          "name": "POST - Tambah mahasiswa",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nim\": \"25{{$timestamp}}\",\n  \"nama\": \"Rina Putri\",\n  \"email\": \"rina.{{$timestamp}}@example.com\",\n  \"prodi_id\": 1,\n  \"angkatan\": 2025\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/mahasiswa"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', function () { pm.response.to.have.status(201); });",
                  "const body = pm.response.json();",
                  "pm.expect(body.success).to.eql(true);",
                  "pm.collectionVariables.set('mahasiswa_id', body.data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "PUT - Ubah mahasiswa",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nim\": \"25{{$timestamp}}\",\n  \"nama\": \"Rina Putri diperbarui\",\n  \"email\": \"rina.{{$timestamp}}@example.com\",\n  \"prodi_id\": 1,\n  \"angkatan\": 2025\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/mahasiswa/{{mahasiswa_id}}"
          }
        },
        {
          "name": "DELETE - Hapus mahasiswa",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": "{{base_url}}/api/mahasiswa/{{mahasiswa_id}}"
          }
        }
      ]
    },
    {
      "name": "Autentikasi",
      "item": [
        {
          "name": "POST - Registrasi berhasil",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"email\": \"{{username}}@example.com\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/register.php"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('username', 'user_' + pm.variables.replaceIn('{{$randomUUID}}'));",
                  "pm.collectionVariables.set('password', 'BelajarAcara20!');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', function () { pm.response.to.have.status(201); });",
                  "pm.expect(pm.response.json().success).to.eql(true);"
                ]
              }
            }
          ]
        },
        {
          "name": "POST - Login (JWT, berlaku 5 menit)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/login.php"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.expect(body.success).to.eql(true);",
                  "pm.expect(body.data.token).to.be.a('string');",
                  "pm.collectionVariables.set('jwt_token', body.data.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "POST - Login gagal (401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"password-salah\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/login.php"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 401', function () { pm.response.to.have.status(401); });"
                ]
              }
            }
          ]
        },
        {
          "name": "POST - Email tidak valid",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"email_invalid_{{$randomUUID}}\",\n  \"email\": \"email-tidak-valid\",\n  \"password\": \"BelajarAcara19!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/register.php"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 422', function () { pm.response.to.have.status(422); });",
                  "const body = pm.response.json();",
                  "pm.expect(body.success).to.eql(false);",
                  "pm.expect(body.errors).to.have.property('email');"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
